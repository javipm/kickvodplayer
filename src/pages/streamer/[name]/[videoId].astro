---
export const prerender = false

import Streamer from '@/components/Streamer'
import Layout from '@/layouts/Layout.astro'

import { getUser } from '@/lib/supabase'
const user = await getUser(Astro.request, Astro.cookies)
const userIsLogged = user !== null

const { name, videoId } = Astro.params
---

<Layout
  title=`Kick VODs Player - ${name}`
  description=`List of VODs from ${name}`
>
  <section class='justify-center mx-auto'>
    {
      name && (
        <Streamer
          streamer={name}
          userIsLogged={userIsLogged}
          videoId={parseInt(videoId || '')}
          client:load
        />
      )
    }
  </section>
</Layout>
