---
import { getUser } from '@/lib/supabase'

const user = await getUser(Astro.request, Astro.cookies)
const displayName =
  user?.user_metadata?.name ??
  user?.user_metadata?.preferred_username ??
  user?.email ??
  ''
const avatarUrl =
  user?.user_metadata?.avatar_url ?? user?.user_metadata?.picture ?? null
const initial = displayName ? displayName.charAt(0).toUpperCase() : '?'
---

<header
  class='sticky top-0 z-40 border-b border-line/80 bg-ink/80 backdrop-blur-md'
>
  <nav
    class='mx-auto flex max-w-screen-lg items-center justify-between px-4 py-3 sm:px-6'
  >
    <a href='/' class='flex items-center gap-2'>
      <span
        class='font-display text-xl font-semibold tracking-tight text-white sm:text-2xl'
      >
        KICK<span class='text-signal'>VOD</span>
      </span>
      <span
        class='hidden rounded-sm border border-line px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.2em] text-white/50 sm:inline-block'
      >
        Player
      </span>
    </a>

    <div class='flex items-center gap-3'>
      {
        user ? (
          <>
            <div class='hidden items-center gap-2 sm:flex'>
              {avatarUrl ? (
                <img
                  src={avatarUrl}
                  alt=''
                  class='h-8 w-8 rounded-full border border-line object-cover'
                />
              ) : (
                <span class='flex h-8 w-8 items-center justify-center rounded-full bg-signal/15 font-mono text-sm font-semibold text-signal'>
                  {initial}
                </span>
              )}
              <span class='max-w-[10rem] truncate font-mono text-xs text-white/70'>
                {displayName}
              </span>
            </div>
            <button
              id='logout'
              type='button'
              class='rounded-sm border border-line px-3 py-1.5 font-mono text-xs uppercase tracking-wide text-white/70 transition hover:border-white/40 hover:text-white disabled:cursor-not-allowed disabled:opacity-60'
            >
              Log out
            </button>
          </>
        ) : (
          <button
            id='login'
            type='button'
            class='inline-flex items-center gap-2 rounded-sm bg-[#9146FF] px-4 py-1.5 font-mono text-xs font-semibold uppercase tracking-wide text-white transition hover:bg-[#7c3aed] disabled:cursor-not-allowed disabled:opacity-60'
          >
            Log in with Twitch
          </button>
        )
      }
    </div>
  </nav>
</header>

<script>
  import { createSupabaseBrowserClient } from '@/lib/supabase-browser'
  import { showToast } from '@/lib/toast'

  const supabase = createSupabaseBrowserClient()

  const loginButton = document.querySelector('#login') as HTMLButtonElement
  if (loginButton) {
    loginButton.onclick = async () => {
      loginButton.disabled = true
      loginButton.textContent = 'Redirecting…'
      const { error } = await supabase.auth.signInWithOAuth({
        provider: 'twitch',
        options: {
          redirectTo: `${window.location.origin}/api/auth/callback`,
        },
      })
      if (error) {
        showToast('Could not start Twitch login. Try again.', 'error')
        loginButton.disabled = false
        loginButton.textContent = 'Log in with Twitch'
      }
    }
  }

  const logoutButton = document.querySelector('#logout') as HTMLButtonElement
  if (logoutButton) {
    logoutButton.onclick = async () => {
      logoutButton.disabled = true
      logoutButton.textContent = 'Logging out…'
      await supabase.auth.signOut()
      window.location.href = '/'
    }
  }
</script>
